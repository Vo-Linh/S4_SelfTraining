# Email notification for training runs (mmseg/core/hook/notification_hook.py).
#
# Copy to .env (already gitignored) and load before launching tools/train.py:
#   set -a; . .env; set +a
#   python tools/train.py configs/daformer/...
#
# If any of SMTP_HOST / SMTP_USER / SMTP_PASSWORD / NOTIFY_RECIPIENT is unset,
# the hook self-disables with a warning and training proceeds normally.
#
# --- Gmail (recommended for personal use) ----------------------------------
# 1. Enable 2FA on the Google account
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Use the 16-char app password below as SMTP_PASSWORD (NOT your real one)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_RECIPIENT=you@gmail.com

# Optional: set to 1 to send a one-line confirmation email when the hook
# initializes, so you don't discover broken SMTP at the end of a multi-hour
# run. Unset/0 to skip.
# NOTIFY_SMOKE_TEST=1
